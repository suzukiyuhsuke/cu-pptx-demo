CU_ENDPOINT="https://<your-resource-name>.cognitiveservices.azure.com"
CU_KEY="<your-key>"
ANALYZER_ID="prebuilt-documentSearch"
API_VERSION="2025-11-01"

# Auth mode: entra | key
AUTH_MODE="entra"

# Locale for CU
LOCALE="ja-JP"

# Translator (optional)
TRANSLATE_TO_JA="True"
TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"
TRANSLATOR_KEY="<your-translator-key>"
TRANSLATOR_REGION="japaneast"

# LLM refine (optional)
LLM_REFINE="True"
LLM_ENDPOINT="https://<your-foundry-or-aoai-resource>.openai.azure.com"
LLM_DEPLOYMENT="<your-deployment-name>"
LLM_API_VERSION="2024-06-01"

# App password (optional)
APP_PASSWORD=""
